diff --git a/nex/ranking/upload_common_data.go b/nex/ranking/upload_common_data.go
new file mode 100644
index 0000000..1825752
--- /dev/null
+++ b/nex/ranking/upload_common_data.go
@@ -0,0 +1,25 @@
+package ranking
+
+import (
+	"github.com/PretendoNetwork/nex-go/v2/types"
+
+	"github.com/PretendoNetwork/pokken-tournament/globals"
+)
+
+// Pretendo LAN : données communes du joueur (profil affiché avec ses scores dans le classement),
+// une par joueur et identifiant unique, table ranking_common_data.
+func UploadCommonData(pid types.PID, uniqueID types.UInt64, commonData types.Buffer) error {
+	globals.Logger.Infof("Ranking::UploadCommonData pid=%d unique_id=%d %d octets", uint64(pid), uint64(uniqueID), len(commonData))
+
+	data := []byte(commonData)
+	if data == nil {
+		data = []byte{}
+	}
+
+	_, err := globals.PostgresDB.Exec(`INSERT INTO ranking_common_data (owner_pid, unique_id, common_data, update_time)
+		VALUES ($1, $2, $3, now())
+		ON CONFLICT (owner_pid, unique_id) DO UPDATE SET common_data = EXCLUDED.common_data, update_time = now()`,
+		int64(pid), int64(uniqueID), data)
+
+	return err
+}
