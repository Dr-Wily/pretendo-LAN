diff --git a/nex/ranking/get_rankings_and_count_by_category_and_ranking_order.go b/nex/ranking/get_rankings_and_count_by_category_and_ranking_order.go
index b4e9a64..0688043 100644
--- a/nex/ranking/get_rankings_and_count_by_category_and_ranking_order.go
+++ b/nex/ranking/get_rankings_and_count_by_category_and_ranking_order.go
@@ -1,11 +1,103 @@
 package ranking
 
 import (
+	"database/sql"
+	"errors"
+	"fmt"
+	"time"
+
 	"github.com/PretendoNetwork/nex-go/v2/types"
 	ranking_types "github.com/PretendoNetwork/nex-protocols-go/v2/ranking/types"
+
+	"github.com/PretendoNetwork/pokken-tournament/globals"
 )
 
-// Stubbed
+// Pretendo LAN : classement d'une catégorie, lu dans ranking_scores.
+//   - sens du tri : OrderBy du dernier score envoyé dans la catégorie (1 = décroissant) ;
+//   - OrderCalculation 0 : rangs « 1224 » (ex æquo au même rang), 1 : rangs « 1234 » ;
+//   - GroupIndex 0 ou 1 : seuls les scores dont l'octet de groupe vaut GroupNum (255 = pas de filtre) ;
+//   - Offset et Length : tranche demandée (Length 0 = 10).
+//
+// Les données communes du joueur (UploadCommonData) sont jointes à chaque ligne.
 func GetRankingsAndCountByCategoryAndRankingOrder(category types.UInt32, rankingOrderParam ranking_types.RankingOrderParam) (types.List[ranking_types.RankingRankData], uint32, error) {
-	return types.List[ranking_types.RankingRankData]{}, 0, nil
+	list := types.List[ranking_types.RankingRankData]{}
+
+	var orderBy int16
+	err := globals.PostgresDB.QueryRow(`SELECT order_by FROM ranking_scores WHERE category = $1 ORDER BY update_time DESC LIMIT 1`,
+		int64(category)).Scan(&orderBy)
+	if errors.Is(err, sql.ErrNoRows) {
+		return list, 0, nil
+	}
+	if err != nil {
+		return list, 0, err
+	}
+
+	direction := "ASC"
+	if orderBy == 1 {
+		direction = "DESC"
+	}
+
+	where := "r.category = $1"
+	groupIndex := uint8(rankingOrderParam.GroupIndex)
+	if groupIndex < 2 {
+		where += fmt.Sprintf(" AND length(r.groups) > %d AND get_byte(r.groups, %d) = %d",
+			groupIndex, groupIndex, uint8(rankingOrderParam.GroupNum))
+	}
+
+	var total uint32
+	if err := globals.PostgresDB.QueryRow("SELECT count(*) FROM ranking_scores r WHERE "+where, int64(category)).Scan(&total); err != nil {
+		return list, 0, err
+	}
+
+	length := uint32(rankingOrderParam.Length)
+	if length == 0 {
+		length = 10
+	}
+
+	rankWindow := fmt.Sprintf("rank() OVER (ORDER BY r.score %s)", direction)
+	if uint8(rankingOrderParam.OrderCalculation) == 1 {
+		rankWindow = fmt.Sprintf("row_number() OVER (ORDER BY r.score %s, r.update_time)", direction)
+	}
+
+	query := fmt.Sprintf(`SELECT owner_pid, unique_id, score, groups, param, update_time, common_data, rk FROM (
+			SELECT r.owner_pid, r.unique_id, r.score, r.groups, r.param, r.update_time,
+				coalesce(c.common_data, ''::bytea) AS common_data,
+				%s AS rk,
+				row_number() OVER (ORDER BY r.score %s, r.update_time) AS rn
+			FROM ranking_scores r
+			LEFT JOIN ranking_common_data c ON c.owner_pid = r.owner_pid AND c.unique_id = r.unique_id
+			WHERE %s
+		) s ORDER BY rn OFFSET %d LIMIT %d`,
+		rankWindow, direction, where, uint32(rankingOrderParam.Offset), length)
+
+	rows, err := globals.PostgresDB.Query(query, int64(category))
+	if err != nil {
+		return list, 0, err
+	}
+	defer rows.Close()
+
+	for rows.Next() {
+		var pid, uniqueID, score, param, rank int64
+		var groups, commonData []byte
+		var updateTime time.Time
+
+		if err := rows.Scan(&pid, &uniqueID, &score, &groups, &param, &updateTime, &commonData, &rank); err != nil {
+			return list, 0, err
+		}
+
+		rankData := ranking_types.NewRankingRankData()
+		rankData.PrincipalID = types.PID(uint64(pid))
+		rankData.UniqueID = types.UInt64(uint64(uniqueID))
+		rankData.Order = types.UInt32(uint32(rank))
+		rankData.Category = category
+		rankData.Score = types.UInt32(uint32(score))
+		rankData.Groups = types.Buffer(groups)
+		rankData.Param = types.UInt64(uint64(param))
+		rankData.CommonData = types.Buffer(commonData)
+		rankData.UpdateTime.FromTimestamp(updateTime.UTC())
+
+		list = append(list, rankData)
+	}
+
+	return list, total, rows.Err()
 }
