@@ -24,6 +24,10 @@ func PasswordFromPID(pid types.PID) (string, uint32) {
 		return passwordFromPIDLocal(pid)
 	}
 
+	if GRPCAccountClient != nil { // Pretendo LAN : serveur de comptes Pretendo
+		return passwordFromPIDAccountGRPC(pid)
+	}
+
 	if len(NEXPasswordSecret) < 32 {
 		return "", nex.ResultCodes.RendezVous.InvalidUsername
 	}
