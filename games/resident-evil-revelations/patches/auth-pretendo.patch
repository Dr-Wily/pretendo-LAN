+++ b/globals/account_grpc.go
@@ -0,0 +1,43 @@
+package globals
+
+// Pretendo LAN : mots de passe NEX demandés au serveur de comptes Pretendo (gRPC v1, comme les serveurs de jeu
+// de Pretendo) au lieu du dérivé HMAC. Actif quand PN_REREV_ACCOUNT_GRPC_HOST est réglé (mode partagé).
+
+import (
+	"context"
+	"fmt"
+
+	pb "github.com/PretendoNetwork/grpc-go/account"
+	"github.com/PretendoNetwork/nex-go/v2"
+	"github.com/PretendoNetwork/nex-go/v2/types"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/metadata"
+)
+
+var GRPCAccountClient pb.AccountClient
+var GRPCAccountMetadata metadata.MD
+
+func ConnectAccountGRPC(host, port, apiKey string) error {
+	conn, err := grpc.Dial(fmt.Sprintf("%s:%s", host, port), grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		return err
+	}
+
+	GRPCAccountClient = pb.NewAccountClient(conn)
+	GRPCAccountMetadata = metadata.Pairs("X-API-Key", apiKey)
+
+	return nil
+}
+
+func passwordFromPIDAccountGRPC(pid types.PID) (string, uint32) {
+	ctx := metadata.NewOutgoingContext(context.Background(), GRPCAccountMetadata)
+
+	response, err := GRPCAccountClient.GetNEXPassword(ctx, &pb.GetNEXPasswordRequest{Pid: uint32(pid)})
+	if err != nil {
+		Logger.Error(err.Error())
+		return "", nex.ResultCodes.RendezVous.InvalidUsername
+	}
+
+	return response.Password, 0
+}
