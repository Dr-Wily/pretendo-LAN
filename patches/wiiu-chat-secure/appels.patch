diff -ruN a/globals/clients.go b/globals/clients.go
--- a/globals/clients.go	1970-01-01 01:00:00.000000000 +0100
+++ b/globals/clients.go	2026-11-08 18:28:14.655609881 +0100
@@ -0,0 +1,34 @@
+package globals
+
+import (
+	"sync"
+
+	nex "github.com/PretendoNetwork/nex-go"
+)
+
+// * Pretendo LAN : dernière connexion vue pour chaque PID. Chaque ouverture de Wii U Chat crée une
+// * nouvelle connexion (autre port), et nex-go garde les anciennes (délai de ping de 65535 s) :
+// * FindClientFromPID en renvoyait une au hasard, souvent morte, et l'appelé n'était plus prévenu.
+var latestClients = map[uint32]*nex.Client{}
+var latestClientsMutex sync.Mutex
+
+// TrackClient mémorise la connexion d'un paquet de données reçu.
+func TrackClient(client *nex.Client) {
+	if client == nil || client.PID() == 0 {
+		return
+	}
+	latestClientsMutex.Lock()
+	defer latestClientsMutex.Unlock()
+	latestClients[client.PID()] = client
+}
+
+// FindClient renvoie la dernière connexion d'un PID si le serveur la connaît encore, sinon nil.
+func FindClient(pid uint32) *nex.Client {
+	latestClientsMutex.Lock()
+	client := latestClients[pid]
+	latestClientsMutex.Unlock()
+	if client == nil || NEXServer.FindClientFromConnectionID(client.ConnectionID()) != client {
+		return nil
+	}
+	return client
+}
