+// * Pretendo LAN : les images de Mii viennent de l'API Mii Studio de Nintendo.
+// * Sans Internet (serveur LAN hors ligne), on utilise une silhouette générique au lieu de
+// * faire échouer la création du PNID ou le changement de Mii. Les vraies images se
+// * régénèrent ensuite avec la commande « pretendo mii-refresh ».
+const OFFLINE_MII_IMAGE = Buffer.from('', 'base64');
+let miiStudioDownUntil = 0; // * après un échec, on n'attend plus Mii Studio pendant 60 s
+
+async function fetchMiiStudioImage(url: string): Promise<Buffer> {
+	if (Date.now() < miiStudioDownUntil) {
+		return OFFLINE_MII_IMAGE;
+	}
+
+	try {
+		return await got(url, { timeout: { request: 5000 }, retry: { limit: 0 } }).buffer();
+	} catch (error) {
+		miiStudioDownUntil = Date.now() + 60000;
+		LOG_WARN(`Mii Studio injoignable, image de Mii générique utilisée : ${(error as Error).message}`);
+		return OFFLINE_MII_IMAGE;
+	}
+}
