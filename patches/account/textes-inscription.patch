+import fs from 'node:fs';
 import express from 'express';
 import xmlbuilder from 'xmlbuilder';
 import timezones from '@/services/nnas/timezones.json';
 
 const router = express.Router();
 
+// * Pretendo LAN : textes d'accord modifiables depuis l'interface d'administration. Le fichier
+// * (PN_LAN_AGREEMENTS_FILE, dossier monté) est relu à chaque demande ; sans fichier valide, ce
+// * sont les textes d'origine. Une entrée par langue proposée à la console.
+interface LanAgreementText {
+	language_name: string;
+	main_title: string;
+	main_text: string;
+	sub_title: string;
+	sub_text: string;
+	agree_text: string;
+	non_agree_text: string;
+}
+
+const lanAgreementFields: (keyof LanAgreementText)[] = ['language_name', 'main_title', 'main_text', 'sub_title', 'sub_text', 'agree_text', 'non_agree_text'];
+const lanDefaultText = 'Welcome to your selfhosted Pretendo server! Have fun! :)';
+const lanDefaultAgreements: LanAgreementText[] = ['English', 'Español', 'Français'].map(languageName => ({
+	language_name: languageName,
+	main_title: 'Pretendo Network Services Agreement',
+	main_text: lanDefaultText,
+	sub_title: 'Privacy Policy',
+	sub_text: lanDefaultText,
+	agree_text: 'I Accept',
+	non_agree_text: 'I Decline'
+}));
+
+function lanAgreements(): LanAgreementText[] {
+	const file = process.env.PN_LAN_AGREEMENTS_FILE;
+
+	if (!file || !fs.existsSync(file)) {
+		return lanDefaultAgreements;
+	}
+
+	try {
+		const data = JSON.parse(fs.readFileSync(file, 'utf8'));
+		const list: Partial<LanAgreementText>[] = Array.isArray(data?.agreements) ? data.agreements : [];
+		const valid = list.filter(entry => lanAgreementFields.every(field => typeof entry[field] === 'string' && entry[field] !== '')) as LanAgreementText[];
+
+		// * La Wii U affiche le choix de la langue dans une fenêtre de 4 boutons : avec 5 langues, elle se
+		// * fige avant de l'afficher (constaté le 05/11/2026)
+		return valid.length ? valid.slice(0, 4) : lanDefaultAgreements;
+	} catch {
+		return lanDefaultAgreements;
+	}
+}
+
+// * Une section CDATA ne peut pas contenir « ]]> »
+const lanCdata = (text: string): string => text.replace(/\]\]>/g, ']] >');
+
 /**
