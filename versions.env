# Versions figées de Pretendo LAN.
# Images Docker et outils : c'est ici qu'on les monte de version. Après modification :
# sudo ./install-server-only.sh --yes (réapplique tout).
# Le code des serveurs (base MatthewL246/pretendo-docker, archivée en mai 2025, et ses
# sous-modules) est copié dans sources/ : sa version est dans sources/SOURCES.tsv, et
# tools/sources.sh le met à jour depuis les dépôts d'origine.
# Ne change jamais la version MAJEURE de MongoDB ou PostgreSQL sans sauvegarde
# et migration des données (voir docs/05-maintenance.md).

# Images de base des Dockerfile de sources/, figées par leur empreinte (tools/sources.sh les
# inscrit dans les Dockerfile) : une étiquette comme node:20-alpine change de contenu au fil
# des mois, et une construction pourrait alors échouer ou se comporter autrement.
BASE_IMAGES="node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
golang:1.22-alpine3.20@sha256:ffd1cc7cf6bd432b951db453439c546f388d8e63100b86b585d2432cbbfa4cea
ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
mitmproxy/mitmproxy:10.4.2@sha256:8ee7377e1dc2dd1b2a0083d9d07d6c3f1e48c69b53b39f8dd000581e72d74498
ghcr.io/wiiu-env/devkitppc:20240505@sha256:54656be0864c518a7da9405acf4e7723e8ca38078feaf12362bed6ae34d0ea9e
python:3.11.18-slim@sha256:064f01707f2fc8b06bae86bb43875266c6e41bac7994e77ec5dc623c4a4d0545"

# Images Docker (upstream utilisait :latest, cause de casse lors des mises à jour)
IMG_COREDNS=coredns/coredns:1.12.1
IMG_NGINX=nginx:1.27-alpine
IMG_MONGO=mongo:8.0
IMG_MONGO_EXPRESS=mongo-express:1.0.2
# minio/minio a été retiré de Docker Hub et de quay.io : fork communautaire Pigsty, compatible
IMG_MINIO=pgsty/minio:RELEASE.2026-06-18T00-00-00Z
IMG_REDIS=redis:7.4-alpine
IMG_POSTGRES=postgres:17-alpine
IMG_MAILPIT=axllent/mailpit:v1.32.0
IMG_ADMINER=adminer:6.2.0
# test NAT local des consoles (config/nncs-local.py)
IMG_PYTHON=python:3.13-alpine
# Proxy des consoles (Inkay), construit le 04/04/2025 par l'auteur de pretendo-docker depuis le code de
# sources/pretendo-docker/repos/mitmproxy-pretendo. Il ne se reconstruit plus : sa base mitmproxy 10.4.2
# est une Debian 11, dont les dépôts sont archivés, et sa construction télécharge Rust et la dernière
# version de « cryptography ». Figé par son empreinte, comme les autres images tierces.
IMG_MITMPROXY=ghcr.io/matthewl246/mitmproxy-pretendo@sha256:ae40295852b8279e5cef0089689633ab57d1dd407969c41c5594d76cad756ea3
# pas de numéro de version publié pour cette image : figée par son empreinte
IMG_REDIS_COMMANDER=ghcr.io/joeferner/redis-commander@sha256:1ad484c1fc0a3b4072dfa2bb10d44f0eba8ecb342c8c0f9e17cb21a6557e4b7e

# Delve, installé par les Dockerfile d'upstream : la dernière version exige un Go plus récent que
# celui de leurs images (golang:1.22), ce qui fait échouer toute construction neuve
DELVE_VERSION=v1.22.1

# Résolveurs des conteneurs DNS, séparés par des espaces. Fixes, car Docker redémarre les conteneurs
# avant que le DHCP ait fourni un DNS : ils resteraient sinon sans résolution extérieure (erreur
# 118-0203 : le test NAT des consoles échoue)
UPSTREAM_DNS="1.1.1.1 9.9.9.9"

# Réseau Docker « default » du projet (upstream ne le fixe pas : Docker peut lui
# donner 172.20.0.0/16, en conflit avec le réseau interne 172.20.0.0/24)
DEFAULT_SUBNET=172.29.250.0/24

# Port du portail web (site Pretendo : inscription, compte, Mii) : http://IP:WEB_PORT
WEB_PORT=8888

# Serveurs de jeux activés (dossiers de games/), séparés par des espaces
GAMES="mario-kart-8"
